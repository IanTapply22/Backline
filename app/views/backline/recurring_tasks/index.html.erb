<% content_for :title, "Backline Recurring Tasks" %>

<div class="backline-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Recurring Tasks</p>
      <h1>Configured schedules and target queues</h1>
    </div>
  </header>

  <section class="card">
    <ul class="list">
      <% if @tasks.any? %>
        <% @tasks.each do |task| %>
          <li>
            <div class="list-row">
              <strong><%= task[:name] %></strong>
              <span class="pill"><%= task[:queue] %></span>
            </div>
            <span><%= task[:schedule] %></span>
          </li>
        <% end %>
      <% else %>
        <li>
          <strong>No recurring tasks configured</strong>
          <span>Add entries to <code>config/recurring.yml</code> to see them here.</span>
        </li>
      <% end %>
    </ul>
  </section>
</div>
