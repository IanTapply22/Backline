<% content_for :title, "Backline Dashboard" %>

<div
  class="backline-shell"
  data-backline-dashboard
  data-backline-dashboard-url-value="<%= live_dashboard_path(days: @snapshot[:charts][:history][:days]) %>"
  data-backline-dashboard-jobs-path-value="<%= jobs_path %>"
  data-backline-dashboard-batches-path-value="<%= batches_path %>"
  data-backline-dashboard-workflows-path-value="<%= workflows_path %>"
  data-backline-dashboard-interval-value="5000"
>
  <section class="hero-band card">
    <div class="hero-band-main">
      <div class="beacon-row">
        <span id="backline-beacon" class="beacon" aria-hidden="true"></span>
        <p class="eyebrow">Live Update</p>
      </div>
      <strong class="live-time" data-backline-dashboard-target="generatedAt"><%= Time.current.strftime("%H:%M:%S") %></strong>
      <p class="hero-note">Dashboard refreshes automatically without reloading the page.</p>
    </div>

    <div class="hero-meta">
      <div class="mini-pills">
        <span class="mini-pill queued">Queued <strong data-backline-dashboard-target="summaryQueued"><%= @snapshot[:summary][:queued] %></strong></span>
        <span class="mini-pill running">Busy <strong data-backline-dashboard-target="summaryRunning"><%= @snapshot[:summary][:running] %></strong></span>
        <span class="mini-pill failed">Retries <strong data-backline-dashboard-target="summaryFailed"><%= @snapshot[:summary][:failed] %></strong></span>
      </div>

      <label class="polling-control" for="backline-refresh-interval">
        <span>Polling interval</span>
        <div class="polling-control-row">
          <input id="backline-refresh-interval" type="range" min="2000" max="20000" step="1000" value="5000" data-backline-dashboard-target="intervalSlider">
          <strong data-backline-dashboard-target="intervalLabel">5 s</strong>
        </div>
      </label>
    </div>
  </section>

  <section class="summary-grid summary-grid-wide">
    <article class="card stat-card">
      <p>Processed</p>
      <strong data-backline-dashboard-target="summaryProcessedTotal"><%= @snapshot[:summary][:processed_total] %></strong>
    </article>
    <article class="card stat-card">
      <p>Busy</p>
      <strong data-backline-dashboard-target="summaryRunning"><%= @snapshot[:summary][:running] %></strong>
    </article>
    <article class="card stat-card">
      <p>Enqueued</p>
      <strong data-backline-dashboard-target="summaryQueued"><%= @snapshot[:summary][:queued] %></strong>
    </article>
    <article class="card stat-card">
      <p>Retries</p>
      <strong data-backline-dashboard-target="summaryFailed"><%= @snapshot[:summary][:failed] %></strong>
    </article>
    <article class="card stat-card">
      <p>Scheduled</p>
      <strong data-backline-dashboard-target="summaryScheduled"><%= @snapshot[:summary][:scheduled] %></strong>
    </article>
    <article class="card stat-card">
      <p>Dead</p>
      <strong data-backline-dashboard-target="summaryDead"><%= @snapshot[:summary][:dead] %></strong>
    </article>
  </section>

  <section class="summary-grid">
    <article class="card stat-card stat-card-compact">
      <p>Rate Limited</p>
      <strong data-backline-dashboard-target="summaryRateLimited"><%= @snapshot[:summary][:rate_limited] %></strong>
    </article>
    <article class="card stat-card stat-card-compact">
      <p>Active Batches</p>
      <strong data-backline-dashboard-target="summaryActiveBatches"><%= @snapshot[:summary][:active_batches] %></strong>
    </article>
    <article class="card stat-card stat-card-compact">
      <p>Active Workflows</p>
      <strong data-backline-dashboard-target="summaryActiveWorkflows"><%= @snapshot[:summary][:active_workflows] %></strong>
    </article>
  </section>

  <section class="two-column">
    <article class="card chart-card">
      <div class="section-heading">
        <h2>Execution Throughput</h2>
        <span>Last 12 hours</span>
      </div>
      <div data-backline-dashboard-target="throughput"></div>
    </article>

    <article class="card chart-card">
      <div class="section-heading">
        <h2>Status Mix</h2>
        <span>Status distributions with ratio  percentages</span>
      </div>
      <div data-backline-dashboard-target="statusDistribution"></div>
    </article>
  </section>

  <section class="card chart-card dashboard-history">
    <div class="section-heading">
      <h2>History</h2>
      <div class="history-filters">
        <% [7, 30, 90, 180].each do |days| %>
          <%= link_to "#{days}d", root_path(days: days), class: "history-filter#{' active' if @snapshot[:charts][:history][:days] == days}" %>
        <% end %>
      </div>
    </div>
    <div data-backline-dashboard-target="history">
      <div class="chart-loading">Loading history chart…</div>
    </div>
  </section>

  <section class="two-column">
    <article class="card">
      <div class="section-heading">
        <h2>Batches</h2>
        <span>Recent grouped fan-out work</span>
      </div>
      <ul class="list" data-backline-dashboard-target="batches">
        <% @snapshot[:batches].each do |batch| %>
          <li>
            <div class="list-row">
              <%= link_to batch[:name], batch_path(batch[:id]) %>
              <span class="pill pill-<%= batch[:status] %>"><%= batch[:status] %></span>
            </div>
            <span><%= batch[:completed_jobs] %> complete, <%= batch[:failed_jobs] %> failed, <%= batch[:total_jobs] %> total</span>
            <div class="queue-depth-track">
              <span class="queue-depth-fill" style="width:<%= batch[:progress_percentage] %>%"></span>
            </div>
          </li>
        <% end %>
      </ul>
    </article>

    <article class="card">
      <div class="section-heading">
        <h2>Workflows</h2>
        <span>Recent chained execution state</span>
      </div>
      <ul class="list" data-backline-dashboard-target="workflows">
        <% @snapshot[:workflows].each do |workflow| %>
          <li>
            <div class="list-row">
              <%= link_to workflow[:name], workflow_path(workflow[:id]) %>
              <span class="pill pill-<%= workflow[:status] %>"><%= workflow[:status] %></span>
            </div>
            <span><%= workflow[:completed_steps] %> completed of <%= workflow[:total_steps] %> steps</span>
            <div class="queue-depth-track">
              <span class="queue-depth-fill" style="width:<%= workflow[:progress_percentage] %>%"></span>
            </div>
          </li>
        <% end %>
      </ul>
    </article>
  </section>

  <section class="card dashboard-footer-card">
    <div class="section-heading">
      <h2>Backend Telemetry</h2>
      <span>Adapter, storage, Redis, and database wiring</span>
    </div>
    <div data-backline-dashboard-target="backend"></div>
  </section>
</div>
