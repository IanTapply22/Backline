<% content_for :title, "Backline Jobs" %>

<div class="backline-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Jobs</p>
      <h1>Searchable Execution History</h1>
    </div>
  </header>

  <%= form_with url: jobs_path, method: :get, class: "filters" do |form| %>
    <%= form.text_field :query, value: params[:query], placeholder: "Search args or metadata" %>
    <%= form.text_field :job_class, value: params[:job_class], placeholder: "Job class" %>
    <%= form.text_field :tenant, value: params[:tenant], placeholder: "Tenant" %>
    <%= form.text_field :user, value: params[:user], placeholder: "User ID" %>
    <%= form.select :queue, options_for_select(@queues.unshift(""), params[:queue]) %>
    <%= form.select :status, options_for_select([ "", "queued", "scheduled", "running", "succeeded", "failed", "dead", "rate_limited" ], params[:status]) %>
    <%= form.submit "Filter", class: "button button-primary" %>
  <% end %>

  <section class="card">
    <div class="table-wrap">
      <table class="jobs-table">
        <thead>
          <tr>
            <th>Class</th>
            <th>Status</th>
            <th>Queue</th>
            <th>Tenant</th>
            <th>User</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody data-backline-jobs-target="rows">
          <% @jobs.each do |job| %>
            <tr>
              <td><%= link_to job.job_class, job_path(job) %></td>
              <td><span class="pill pill-<%= job.status %>"><%= job.status %></span></td>
              <td><%= job.queue_name %></td>
              <td><%= job.tenant_key.presence || "—" %></td>
              <td><%= job.user_key.presence || "—" %></td>
              <td>
                <div class="jobs-timestamp" data-backline-local-time="<%= job.created_at&.iso8601 %>">
                  <strong><%= job.created_at&.strftime("%b %-d, %Y %H:%M:%S") %></strong>
                  <span><%= time_ago_in_words(job.created_at) %> ago</span>
                </div>
              </td>
              <td>
                <div class="table-actions">
                  <%= link_to "Open", job_path(job), class: "button button-small" %>
                  <% if job.failed? || job.dead? %>
                    <%= button_to "Retry", retry_job_job_path(job), method: :post, class: "button button-small button-primary", form: { class: "inline-form" } %>
                  <% end %>
                  <% if job.killable? %>
                    <%= button_to "Kill", kill_job_job_path(job), method: :post, class: "button button-small button-danger", form: { class: "inline-form" } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
