<% content_for :title, @batch.name %>

<div class="backline-shell">
  <header class="page-header">
    <div>
      <p class="eyebrow">Batch</p>
      <h1><%= @batch.name %></h1>
    </div>
  </header>

  <section class="summary-grid">
    <article class="card stat-card"><p>Status</p><strong><%= @batch.status %></strong></article>
    <article class="card stat-card"><p>Total jobs</p><strong><%= @batch.total_jobs %></strong></article>
    <article class="card stat-card"><p>Completed</p><strong><%= @batch.completed_jobs %></strong></article>
    <article class="card stat-card"><p>Failed</p><strong><%= @batch.failed_jobs %></strong></article>
  </section>
</div>
